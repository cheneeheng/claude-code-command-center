// Command Center install config — copy to ~/.claude-command-center/config.json
// and remove these // comments (config.json must be strict JSON; the .jsonc here is
// only documentation). Only members you want `install -All` to configure need an entry.
{
  // statusline-hook: which implementation to wire into settings.json.
  // "ps1" (PowerShell) or "sh" (bash + jq). Optional; defaults to ps1.
  // claudeDir sets the config dir to install into (default ~/.claude); optional.
  "statusline-hook": { "variant": "ps1" },
  // To wire the hook into more than one config dir, use an instances array instead
  // (one entry per dir); the single-object form above stays valid for a single dir:
  // "statusline-hook": {
  //   "instances": [
  //     { "variant": "ps1", "claudeDir": "C:/Users/you/.claude" },
  //     { "variant": "sh", "claudeDir": "C:/Users/you/.claude_work" }
  //   ]
  // },

  // file-sync: one entry per folder pair to keep in sync. REQUIRED for install -All
  // (there is no sensible default folder pair). strategy is "raw" or "json-merge";
  // excludePaths (json-merge only) is a comma-separated list of dot-paths to preserve.
  "file-sync": {
    "instances": [
      {
        "fileName": "CLAUDE.md",
        "folderA": "C:/Users/you/.claude",
        "folderB": "C:/Users/you/.claude_mirror",
        "strategy": "raw",
        "intervalMinutes": 15
      },
      {
        "fileName": "settings.json",
        "folderA": "C:/Users/you/.claude",
        "folderB": "C:/Users/you/.claude_mirror",
        "strategy": "json-merge",
        "excludePaths": "statusLine.command",
        "intervalMinutes": 15
      }
    ]
  },

  // scheduled-session-digests: optional. metaDir defaults to $env:C4_CLAUDE_META_DIR,
  // then ~/claude-meta. Schedule times and the rest live in the member's own
  // config.json (see tools/scheduled-session-digests/README.md).
  "scheduled-session-digests": {
    "metaDir": "C:/Users/you/claude-meta"
  },

  // agents-workspace-sync: the .agents_workspace repos to commit and push daily. REQUIRED
  // for install -All (there is no sensible default repo list). scheduleTime defaults to
  // 04:00; metaDir defaults like the digests' does.
  "agents-workspace-sync": {
    "repos": ["C:/Users/you/projects/my-repo/.agents_workspace"],
    "scheduleTime": "04:00"
  },

  // marketplace-updater: the marketplaces to refresh and the repos whose local/project-scope
  // plugins from them get updated. REQUIRED for install -All (no sensible default exists for
  // either). intervalMinutes (1-1439) defaults to 360.
  "marketplace-updater": {
    "marketplaces": ["my-marketplace"],
    "repos": ["C:/Users/you/projects/my-repo"],
    "intervalMinutes": 360
  }

  // session-name-date-prefixer, usage-dashboard, and usage-insights need no config: give each an empty {}
  // to opt it into install -All.
}
