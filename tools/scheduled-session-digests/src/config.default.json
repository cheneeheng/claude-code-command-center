{
  "schedule": { "dailyAt": "03:00", "weeklyDay": "Sunday", "weeklyAt": "04:00" },
  "thresholds": { "minUserTurns": 2, "minTranscriptChars": 500 },
  "firstRunDays": 7,
  "maxSessionsPerRun": 20,
  "maxAttempts": 3,
  "settleMinutes": 60,
  "weeklyBatchChars": 400000,
  "models": {
    "daily": { "model": "sonnet", "effort": "medium" },
    "weekly": { "model": "opus", "effort": "medium" }
  },
  "extractions": {
    "lessons": {
      "enabled": true,
      "prompt": "extract/lessons.md",
      "outputDir": "lessons-learned",
      "none": "_No lessons extracted from this session._",
      "weekly": { "prompt": "merge/lessons.md", "master": "master-lessons/MASTER_LESSONS_LEARNED.md" }
    },
    "decisions": {
      "enabled": false,
      "prompt": "extract/decisions.md",
      "outputDir": "decisions",
      "none": "_No decisions extracted from this session._",
      "weekly": {
        "prompt": "merge/decisions.md",
        "master": "SOUL.md",
        "mode": "replace",
        "maxLines": 150,
        "questions": { "enabled": true, "label": "decision-question" }
      }
    }
  }
}
