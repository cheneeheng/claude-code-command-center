# Secrets / local env — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*

# Node / JS
node_modules/
*.vsix

# OS / editor cruft
.DS_Store
Thumbs.db

# file-sync: per-(file, pair) hidden launchers generated on install embed real local
# paths — keep them out of git (the committed hidden.vbs template stays tracked).
tools/file-sync/file-sync-*-hidden.vbs

# .agents_workspace is its own git repo (orphan branch on the shared
# agents-workspace remote), synced by tools/agents-workspace-sync.
.agents_workspace/
